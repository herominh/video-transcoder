{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-hub.invalid/import/v1/input.schema.json",
  "title": "Import contract v1: the input of one import job, sent by the Hub",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "job",
    "file_id",
    "resource_key",
    "expected",
    "plan",
    "parts",
    "receipt_url",
    "writes_end_at",
    "mac"
  ],
  "properties": {
    "contract": {
      "const": "import/v1"
    },
    "job": {
      "$ref": "#/$defs/uuid"
    },
    "file_id": {
      "$ref": "#/$defs/file_id"
    },
    "resource_key": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/resource_key"
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "md5",
        "sha1",
        "sha256",
        "head_revision_id"
      ],
      "properties": {
        "size": {
          "$ref": "#/$defs/size"
        },
        "md5": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/md5"
            }
          ]
        },
        "sha1": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha1"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "head_revision_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/head_revision_id"
            }
          ]
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_size",
        "parts_total"
      ],
      "properties": {
        "part_size": {
          "const": 67108864
        },
        "parts_total": {
          "$ref": "#/$defs/part_number"
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 160,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "url"
        ],
        "properties": {
          "n": {
            "$ref": "#/$defs/part_number"
          },
          "url": {
            "$ref": "#/$defs/https_url"
          }
        }
      }
    },
    "receipt_url": {
      "$ref": "#/$defs/https_url"
    },
    "writes_end_at": {
      "$ref": "#/$defs/timestamp"
    },
    "mac": {
      "$ref": "#/$defs/mac"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10737418240
    },
    "part_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 160
    },
    "file_id": {
      "type": "string",
      "minLength": 10,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]{10,128}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "resource_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "md5": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "sha1": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "head_revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[\\x21-\\x7e]{1,255}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "https_url": {
      "type": "string",
      "minLength": 9,
      "maxLength": 4096,
      "pattern": "^https://[\\x21-\\x7e]+$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 27,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "mac": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    }
  }
}
