{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-hub.invalid/import/v1/receipt.schema.json",
  "title": "Import contract v1: the receipt the worker writes beside the original after its last part",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "job",
    "bytes",
    "checksum_verified",
    "parts",
    "mac"
  ],
  "properties": {
    "contract": {
      "const": "import/v1"
    },
    "job": {
      "$ref": "#/$defs/uuid"
    },
    "bytes": {
      "$ref": "#/$defs/size"
    },
    "checksum_verified": {
      "enum": [
        "sha256",
        "md5",
        "none"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 160,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "etag"
        ],
        "properties": {
          "n": {
            "$ref": "#/$defs/part_number"
          },
          "etag": {
            "$ref": "#/$defs/etag"
          }
        }
      }
    },
    "mac": {
      "$ref": "#/$defs/mac"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10737418240
    },
    "part_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 160
    },
    "etag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21\\x23-\\x7e]{1,128}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "mac": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    }
  }
}
