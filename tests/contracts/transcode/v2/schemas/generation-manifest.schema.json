{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-hub.invalid/transcode/v2/schemas/generation-manifest.schema.json",
  "title": "Transcode contract v2: generation.manifest 1.0.0-draft (worker-written candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "document_kind",
    "generation_id",
    "created_at",
    "identity",
    "profile",
    "encryption",
    "media",
    "renditions",
    "master_playlist_path",
    "thumbnail_path",
    "artifact_count",
    "total_bytes",
    "artifacts"
  ],
  "properties": {
    "manifest_version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "document_kind": {
      "type": "string",
      "const": "generation.manifest"
    },
    "generation_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "identity": {
      "$ref": "common.schema.json#/$defs/identity_manifest"
    },
    "profile": {
      "$ref": "common.schema.json#/$defs/profile"
    },
    "encryption": {
      "$ref": "common.schema.json#/$defs/encryption"
    },
    "media": {
      "$ref": "common.schema.json#/$defs/media"
    },
    "renditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "width",
          "height",
          "bandwidth_bps",
          "average_bandwidth_bps",
          "codecs",
          "playlist_path"
        ],
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/rendition_name"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3840
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3840
          },
          "bandwidth_bps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
          },
          "average_bandwidth_bps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
          },
          "codecs": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9.]{1,32}(,[A-Za-z0-9.]{1,32})?$",
            "not": {
              "pattern": "[\\x00-\\x1f\\x7f]"
            }
          },
          "playlist_path": {
            "$ref": "common.schema.json#/$defs/rel_path"
          }
        }
      }
    },
    "master_playlist_path": {
      "$ref": "common.schema.json#/$defs/rel_path"
    },
    "thumbnail_path": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/rel_path"
        }
      ]
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25209
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1099511627776
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 25209,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "common.schema.json#/$defs/rel_path"
          },
          "kind": {
            "type": "string",
            "enum": [
              "hls_master_playlist",
              "hls_media_playlist",
              "hls_segment",
              "thumbnail"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967296
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "rendition": {
            "$ref": "common.schema.json#/$defs/rendition_name"
          }
        },
        "if": {
          "properties": {
            "kind": {
              "enum": [
                "hls_media_playlist",
                "hls_segment"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        "then": {
          "required": [
            "rendition"
          ]
        },
        "else": {
          "not": {
            "required": [
              "rendition"
            ]
          }
        }
      }
    },
    "diagnostics": {
      "$ref": "common.schema.json#/$defs/diagnostics"
    }
  }
}
