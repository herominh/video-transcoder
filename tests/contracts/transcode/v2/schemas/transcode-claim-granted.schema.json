{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-hub.invalid/transcode/v2/schemas/transcode-claim-granted.schema.json",
  "title": "Transcode contract v2: transcode.claim.granted (Hub to worker)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "message_kind",
    "message_id",
    "sent_at",
    "audience",
    "key_id",
    "identity",
    "runtime_id",
    "generation_id",
    "output"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "message_kind": {
      "type": "string",
      "const": "transcode.claim.granted"
    },
    "message_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "sent_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "audience": {
      "$ref": "common.schema.json#/$defs/audience"
    },
    "key_id": {
      "$ref": "common.schema.json#/$defs/key_id"
    },
    "identity": {
      "$ref": "common.schema.json#/$defs/identity_execution"
    },
    "runtime_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "generation_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_id",
        "prefix"
      ],
      "properties": {
        "location_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "prefix": {
          "$ref": "common.schema.json#/$defs/object_key"
        }
      }
    },
    "media_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_key_id",
        "key_hex"
      ],
      "properties": {
        "media_key_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "key_hex": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f]"
          }
        }
      }
    }
  }
}
