{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-hub.invalid/transcode/v2/schemas/transcode-request.schema.json",
  "title": "Transcode contract v2: transcode.request (Hub to worker)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "message_kind",
    "message_id",
    "sent_at",
    "audience",
    "key_id",
    "identity",
    "source",
    "output",
    "profile",
    "renditions",
    "encryption",
    "limits",
    "claim"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "message_kind": {
      "type": "string",
      "const": "transcode.request"
    },
    "message_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "sent_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "audience": {
      "$ref": "common.schema.json#/$defs/audience"
    },
    "key_id": {
      "$ref": "common.schema.json#/$defs/key_id"
    },
    "identity": {
      "$ref": "common.schema.json#/$defs/identity_dispatch"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "location_id",
        "bucket",
        "credential_ref",
        "object_key",
        "size_bytes",
        "etag"
      ],
      "properties": {
        "source_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "location_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "bucket": {
          "$ref": "common.schema.json#/$defs/bucket"
        },
        "credential_ref": {
          "$ref": "common.schema.json#/$defs/credential_ref"
        },
        "object_key": {
          "$ref": "common.schema.json#/$defs/object_key"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32212254720
        },
        "etag": {
          "$ref": "common.schema.json#/$defs/etag"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_id",
        "bucket",
        "credential_ref"
      ],
      "properties": {
        "location_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "bucket": {
          "$ref": "common.schema.json#/$defs/bucket"
        },
        "credential_ref": {
          "$ref": "common.schema.json#/$defs/credential_ref"
        }
      }
    },
    "profile": {
      "$ref": "common.schema.json#/$defs/profile"
    },
    "renditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/rendition_name"
      }
    },
    "encryption": {
      "$ref": "common.schema.json#/$defs/encryption"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_source_bytes",
        "max_source_duration_ms",
        "max_output_bytes",
        "max_artifact_count",
        "max_wall_time_ms"
      ],
      "properties": {
        "max_source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32212254720
        },
        "max_source_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21600000
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "max_artifact_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25209
        },
        "max_wall_time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap_token",
        "expires_at"
      ],
      "properties": {
        "bootstrap_token": {
          "$ref": "common.schema.json#/$defs/bootstrap_token"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
