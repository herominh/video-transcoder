{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-hub.invalid/transcode/v2/schemas/trusted-context.schema.json",
  "title": "Transcode contract v2: trusted context of a validator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_version",
    "role",
    "channel",
    "accepted_message_kinds"
  ],
  "properties": {
    "context_version": {
      "type": "integer",
      "const": 1,
      "minimum": 1,
      "maximum": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "hub_receiver",
        "hub_sender",
        "worker_receiver",
        "worker_sender"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "push",
        "poll",
        "dispatch",
        "storage"
      ]
    },
    "now": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      ]
    },
    "clock_skew_s": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        }
      ]
    },
    "accepted_protocol_versions": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/version"
          }
        }
      ]
    },
    "accepted_manifest_versions": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/version"
          }
        }
      ]
    },
    "accepted_message_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "transcode.request",
          "transcode.progress",
          "transcode.result.completed",
          "transcode.result.failed",
          "hub.error",
          "generation.manifest"
        ]
      }
    },
    "expected_audience": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/audience"
        }
      ]
    },
    "known_key_ids": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/key_id"
          }
        }
      ]
    },
    "expect": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/expect"
        }
      ]
    },
    "last_event_seq": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      ]
    }
  },
  "$defs": {
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "org_uuid": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          ]
        },
        "video_uuid": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          ]
        },
        "owning_cell_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/cell_id"
            }
          ]
        },
        "placement_epoch": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/fence_positive"
            }
          ]
        },
        "lifecycle_revision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/revision"
            }
          ]
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          ]
        },
        "dispatch_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          ]
        },
        "execution_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          ]
        },
        "execution_fence": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/fence_positive"
            }
          ]
        },
        "source_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          ]
        },
        "source_location_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          ]
        },
        "output_location_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          ]
        },
        "profile": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/profile"
            }
          ]
        },
        "encryption": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/encryption"
            }
          ]
        },
        "renditions": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/rendition_name"
              }
            }
          ]
        },
        "max_artifact_count": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 25209
            }
          ]
        }
      }
    }
  }
}
